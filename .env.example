# Attribut waitlist (Supabase project: Attribut)
# The publishable key is safe to expose in the browser. Row level security on
# the waitlist table allows inserts only, never reads.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# ---------------------------------------------------------------------------
# Client dashboard and Instagram automation (server only).
# None of these may ever have a VITE_ prefix: that would ship them to browsers.
# Set them in Netlify: Site configuration > Environment variables.
# ---------------------------------------------------------------------------

# Supabase project that holds clients, sessions, and automations (ClientsForge).
SUPABASE_URL=https://your-project.supabase.co
# Service role key. Bypasses row level security, so it is server only.
# Supabase dashboard > Project settings > API keys > service_role (secret).
SUPABASE_SERVICE_ROLE_KEY=

# Public origin of the site, no trailing slash. Builds the OAuth redirect URI
# (APP_BASE_URL/api/instagram/callback) and the data deletion status URL.
APP_BASE_URL=https://clientsforge.com

# Signs the Instagram OAuth state to the signed in client. 48+ random bytes.
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Encrypts Instagram access tokens at rest with AES-256-GCM. Exactly 32 bytes,
# base64 encoded. Changing it makes every stored token unreadable, so all
# clients would need to reconnect Instagram.
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# Any random string. Paste the same value into the Meta webhook settings.
META_WEBHOOK_VERIFY_TOKEN=

# Guards the manual job triggers at /api/cron/*. Send as "Authorization: Bearer".
CRON_SECRET=

# Meta app > Instagram > API setup with Instagram login > App settings.
INSTAGRAM_APP_ID=
# Same screen. Also verifies webhook signatures and signed requests.
INSTAGRAM_APP_SECRET=

# Graph API version for every Instagram call. Verified against Meta's docs.
META_GRAPH_API_VERSION=v25.0
